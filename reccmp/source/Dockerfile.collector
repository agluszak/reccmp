FROM debian:trixie-slim
# LLVM 21 comes from trixie-backports; one transaction, since it pulls
# backported libraries (libcurl) that stable curl would conflict with.
RUN echo "deb http://deb.debian.org/debian trixie-backports main" \
    > /etc/apt/sources.list.d/backports.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends -t trixie-backports \
    clang-21 \
    llvm-21-dev \
    libclang-21-dev \
    libclang-cpp21-dev \
    ca-certificates \
    curl \
  && ln -sf /usr/bin/clang-21 /usr/bin/clang \
  && ln -sf /usr/bin/clang++-21 /usr/bin/clang++ \
  && ln -sf /usr/bin/clang-21 /usr/bin/clang-cl \
  && rm -rf /var/lib/apt/lists/*
COPY reccmp/source/indexer.cpp /tmp/indexer.cpp
RUN clang++ -O2 -std=c++17 -fno-rtti -fno-exceptions \
      -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS \
      -I/usr/lib/llvm-21/include /tmp/indexer.cpp \
      -o /usr/local/bin/reccmp-source-indexer \
      /usr/lib/llvm-21/lib/libclang-cpp.so.21.1 \
      /usr/lib/llvm-21/lib/libLLVM.so.21.1 \
  && rm /tmp/indexer.cpp
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
ENV RECCMP_SOURCE_INDEXER=/usr/local/bin/reccmp-source-indexer
